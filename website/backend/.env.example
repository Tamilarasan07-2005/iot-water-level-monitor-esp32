# Backend environment variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ThingsBoard device access token (from ThingsBoard → Device → Copy Access Token)
DEVICE_TOKEN=YOUR_DEVICE_ACCESS_TOKEN

# ThingsBoard user JWT (Settings → Security → Generate User Token)
# Note: JWTs expire — regenerate and update this value periodically
TB_USER_TOKEN=YOUR_USER_JWT_TOKEN

# ThingsBoard device UUID (Devices → click device → copy ID from URL)
DEVICE_ID=YOUR_DEVICE_UUID

# Google Drive folder ID (right-click folder in Drive → Get link → extract ID from URL)
FOLDER_ID=YOUR_GOOGLE_DRIVE_FOLDER_ID

# Server port (optional — defaults to 5000)
PORT=5000
